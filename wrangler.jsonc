{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebookcc",
  "compatibility_date": "2026-07-31",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ebookcc-media"
    }
  ]
}
